    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now=Date.now(); return $input.all().filter(i=>String(i.json['Call Status']??'')==='SCHEDULED').filter(i=>{const t=new Date(i.json['Scheduled For']??'').getTime();return Number.isFinite(t)&&t<=now;});"
      },
