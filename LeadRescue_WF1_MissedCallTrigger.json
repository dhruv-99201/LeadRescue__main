            "Customer Phone": "={{ $json.customerPhone }}",
            "Client Number": "={{ $json.clientOriginalNumber }}",
            "Call SID": "={{ $json.callSid }}",
            "Call Status": "PENDING"
          }
        },
        "options": {}
      },
