    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call/phone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phoneNumberId\": \"REPLACE_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": {\n    \"number\": \"{{ $json.customerPhone }}\"\n  },\n  \"assistantId\": \"REPLACE_VAPI_ASSISTANT_ID\",\n  \"assistantOverrides\": {\n    \"voice\": {\n      \"provider\": \"cartesia\",\n      \"voiceId\": \"REPLACE_CARTESIA_VOICE_ID\",\n      \"model\": \"sonic-3.6\",\n      \"speed\": 0.95\n    },\n    \"transcriber\": {\n      \"provider\": \"deepgram\",\n      \"model\": \"nova-3\",\n      \"language\": \"en\",\n      \"smartFormat\": true\n    },\n    \"model\": {\n      \"provider\": \"openai\",\n      \"model\": \"gpt-6-luna\"\n    },\n    \"variableValues\": {\n      \"leadId\": \"{{ $json.leadId }}\",\n      \"customerPhone\": \"{{ $json.customerPhone }}\",\n      \"businessName\": \"REPLACE_BUSINESS_NAME\",\n      \"aiName\": \"REPLACE_AI_NAME\"\n    }\n  }\n}",
        "options": {}
      },
