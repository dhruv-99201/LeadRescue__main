{
  "name": "LeadRescue — WF1: Missed Call Trigger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "leadrescue-missed-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf1-webhook",
      "name": "Twilio Missed Call Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "leadrescue-missed-call"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>",
        "options": {
          "responseHeaders": {
            "entries": [{"name": "Content-Type", "value": "text/xml"}]
          }
        }
      },
      "id": "wf1-respond",
      "name": "Respond to Twilio (200 OK)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [460, 180]
    },
    {
      "parameters": {
        "jsCode": "\n// LeadRescue | WF1 — Missed Call Parser\n// Trigger: Twilio receives forwarded unanswered call\n// Voice stack: Cartesia Sonic-3.6 + Deepgram Nova-3 + gpt-6-luna\n// Audit v7: after-hours SCHEDULED queue, model updates\n\nconst body = $input.first().json?.body ?? $input.first().json ?? {};\n\nconst rawCustomerPhone     = body?.From          ?? body?.from          ?? '';\nconst leadsRescueNumber    = body?.To            ?? body?.to            ?? '';\nconst clientOriginalNumber = body?.ForwardedFrom ?? body?.forwardedFrom ?? leadsRescueNumber;\nconst callSid              = body?.CallSid       ?? body?.callSid       ?? '';\n\nconst cleanPhone = rawCustomerPhone.replace(/\\D/g, '');\n\nif (!cleanPhone || cleanPhone.length < 10) {\n  return [{\n    json: {\n      isValid: false,\n      validationError: 'No valid customer phone number in Twilio payload.',\n      callStatus: 'INVALID',\n      rawCustomerPhone,\n      callSid,\n      timestamp: new Date().toISOString(),\n    }\n  }];\n}\n\nconst customerPhone = rawCustomerPhone.startsWith('+')\n  ? rawCustomerPhone\n  : '+1' + cleanPhone;\n\n// TCPA: No calls before 8am or after 9pm CT\nconst now = new Date();\nconst ctHour = parseInt(\n  new Intl.DateTimeFormat('en-US', {\n    timeZone: 'America/Chicago',\n    hour: 'numeric',\n    hour12: false\n  }).format(now)\n);\nconst isBusinessHours = ctHour >= 8 && ctHour < 21;\n\n// For after-hours leads: calculate next eligible window open\n// Schedule callback for 8:00 AM CT next business day\nconst nextWindowOpen = (() => {\n  const ct = new Date(now.toLocaleString('en-US', { timeZone: 'America/Chicago' }));\n  ct.setHours(8, 0, 0, 0);\n  // If after 8am today (but after 9pm), next window is tomorrow at 8am\n  if (ct <= now) ct.setDate(ct.getDate() + 1);\n  return ct.toISOString();\n})();\n\nconst leadId = `LR-${Date.now()}`;\n\nreturn [{\n  json: {\n    isValid: true,\n    validationError: null,\n    leadId,\n    customerPhone,\n    clientOriginalNumber,\n    leadsRescueNumber,\n    callSid,\n    isBusinessHours,\n    currentHourCT: ctHour,\n    callStatus: isBusinessHours ? 'PENDING' : 'SCHEDULED',\n    scheduledFor: isBusinessHours ? null : nextWindowOpen,\n    timestamp: now.toISOString(),\n  }\n}];\n"
      },
      "id": "wf1-parser",
      "name": "Parse & Validate Missed Call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.isValid }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
            },
            {
              "leftValue": "={{ $json.isBusinessHours }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf1-biz-hours",
      "name": "Valid + Business Hours?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "unit": "minutes",
        "value": 2
      },
      "id": "wf1-wait",
      "name": "Wait 2 Minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [900, 320]
    },
    {
