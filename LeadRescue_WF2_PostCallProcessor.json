m(),issue=String(sd.issueDescription??\"\").trim(),outcome=String(sd.callOutcome??\"incomplete\").toLowerCase(),urgency=String(sd.urgencyLevel??\"standard\").toLowerCase();\nconst speech=um.length>0||/^user\\s*:/im.test(transcript),ghost=[\"no-answer\",\"customer-did-not-answer\",\"customer-did-not-pick-up\",\"voicemail\",\"no-answer-machine\"].includes(endedReason)||(duration<8&&!speech),txt=(ut+\" \"+issue+\" \"+service).toLowerCase();\nconst life=[\"gas smell\",\"smell gas\",\"natural gas\",\"carbon monoxide\",\"co detector\",\"fire\",\"smoke\",\"sparks\",\"electrical arcing\"].some(k=>txt.includes(k)),emerg=!ghost&&(sd.isEmergency===true||life||[\"leak\",\"burst pipe\",\"flooding\",\"flood\",\"sewage backup\",\"sewage\",\"overflow\",\"no heat\",\"no ac\",\"no air conditioning\"].some(k=>txt.includes(k)));\nconst meaningful=service.length>1&&![\"unknown\",\"not specified\"].includes(service.toLowerCase()),interest=sd.isInterested===true||sd.appointmentRequested===true||[\"interested\",\"callback_requested\"].includes(outcome),qualified=!ghost&&meaningful&&interest;\nreturn [{json:{isEndOfCallReport:type===\"end-of-call-report\",messageType:type,leadId,vapiCallId,eventId,customerPhone:phone,callDuration:Math.round(duration),endedReason,summary:String(msg.analysis?.summary??call.analysis?.summary??msg.summary??\"\").trim(),transcript,customerText:ut,structuredData:sd,customerLocation:{serviceLocation:sl||\"Unknown\",city,areaReference:area,locationConfirmed:loc.locationConfirmed===true},locationDisplay:display,isGhost:ghost,isEmergency:emerg,isLifeSafety:life,isQualified:qualified,resolvedPath:emerg?\"EMERGENCY\":ghost?\"GHOST\":qualified?\"QUALIFIED\":\"UNQUALIFIED\",serviceType:service,issueDescription:issue,urgencyLevel:urgency,preferredTimeWindow:String(sd.preferredTimeWindow??\"\"),appointmentRequested:sd.appointmentRequested===true,callOutcome:outcome,additionalNotes:String(sd.additionalNotes??\"\"),startedAt,processedAt:new Date().toISOString()}}];"
