{
  "name": "LeadRescue — WF3: Stale Lead Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "wf3-schedule",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SHEETS_DOC_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      },
      "id": "wf3-sheets-read",
      "name": "Read All Leads from Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_SHEETS_CRED_ID",
          "name": "Google Sheets"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst now=Date.now(), rows=$input.all().map(i=>i.json), stale=[];\nfor(const r of rows){\n const status=String(r['Call Status']??''), rawTime=r['Last Updated At']||r['Timestamp']||'', t=new Date(rawTime).getTime(), age=Number.isFinite(t)?now-t:Infinity, due=new Date(r['Scheduled For']||'').getTime(), last=new Date(r['Stale Alerted At']||'').getTime(), cooldown=!Number.isFinite(last)||(now-last)>=3600000;\n let reason='';\n if(status==='CALL_FAILED')reason='callback creation failed';\n else if(status==='PENDING'&&age>600000)reason='PENDING >10 minutes';\n else if(status==='CALL_REQUESTED'&&age>600000)reason='CALL_REQUESTED >10 minutes';\n else if(status==='VAPI_FIRED'&&age>1800000)reason='no end-of-call report >30 minutes';\n else if(status==='PROCESSING_CALLBACK'&&age>600000)reason='processing stuck >10 minutes';\n else if(status==='SCHEDULED'&&Number.isFinite(due)&&due<now-600000)reason='scheduled callback overdue >10 minutes';\n if(reason&&cooldown)stale.push({...r,staleReason:reason});\n}\nconst lines=stale.slice(0,5).map(r=>'- '+(r['Lead ID']||'?')+' | '+(r['Customer Phone']||'?')+' | '+r.staleReason).join('\\\\n');\nreturn [{json:{hasStaleLeads:stale.length>0,count:stale.length,staleRows:stale,alertMessage:stale.length?'⚠️ LeadRescue monitor: '+stale.length+' lead(s) need attention.\\\\n'+lines+(stale.length>5?'\\\\nMore rows are in Leads sheet.':'')+'\\\\nInspect n8n executions and reconcile.':''}}];"
      },
      "id": "wf3-checker",
      "name": "Check for Stale PENDING Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.hasStaleLeads }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf3-stale-check",
      "name": "Has Stale Leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "from": "REPLACE_TWILIO_FROM_NUMBER",
        "to": "REPLACE_ADMIN_PHONE",
        "message": "={{ $json.alertMessage }}\n\nReply STOP to opt out.",
        "options": {}
      },
      "id": "wf3-alert-sms",
      "name": "SMS — Stale Lead Alert",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_TWILIO_CRED_ID",
          "name": "Twilio"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$('Check for Stale PENDING Leads').first().json.staleRows??[], now=new Date().toISOString(); return rows.map(r=>({json:{'Lead ID':r['Lead ID'],'Stale Alerted At':now}}));"
      },
